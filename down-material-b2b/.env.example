# 数据库
DATABASE_URL="postgresql://down_user:down_password@localhost:5432/down_factory?schema=public"
# Prisma 结构迁移专用直连 / Session Pooler；本地 PostgreSQL 可与 DATABASE_URL 相同
DIRECT_URL="postgresql://down_user:down_password@localhost:5432/down_factory?schema=public"

# Supabase（用于 CMS、后台设置和历史档案；公开站不写入访客联系资料）
SUPABASE_PROJECT_REF=""
SUPABASE_DATABASE_PASSWORD=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="inquiry-attachments"

# 登录与站点（生产环境必须替换随机长字符串）
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 额外图片 CDN 域名，逗号分隔且不含协议/路径；阿里云 OSS/CDN 已内置允许
NEXT_PUBLIC_IMAGE_HOSTS=""
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="replace-before-seeding"

# 统计和站长验证（留空即不启用）
NEXT_PUBLIC_BAIDU_ANALYTICS_ID=""
NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=""
NEXT_PUBLIC_SOGOU_SITE_VERIFICATION=""
NEXT_PUBLIC_360_SITE_VERIFICATION=""
BAIDU_PUSH_TOKEN=""

# Cloudflare Workers 本地预览另复制 .dev.vars.example 为 .dev.vars。
# 生产值通过 Cloudflare Build variables / Worker Variables and Secrets 配置，勿提交本文件中的真实值。
